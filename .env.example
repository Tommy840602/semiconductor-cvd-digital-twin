# Local demo only; compose binds the website and API to localhost.
POSTGRES_PASSWORD=cvd-local

# Leader password file is required only for the first account bootstrap.
# Keep this file outside version control; use a 12+ character secret (max 72 UTF-8 bytes).
CVD_LEADER_PASSWORD_FILE=./.runtime/secrets/leader-password
# Exact HTTPS origin for WebSocket handshakes; empty permits local development only.
CVD_PUBLIC_ORIGIN=

# Shared signing key for approved single-wafer recovery commands.
# Create once with python3 scripts/init-recovery-key.py; never overwrite while intents exist.
CVD_RECOVERY_KEY_FILE=./.runtime/secrets/recovery-key

# Default runtime after generating compose.secs.yaml and secrets.
COMPOSE_FILE=compose.yaml:compose.secs.yaml

# Add compose.vision.yaml to COMPOSE_FILE after preparing scripts/prepare-vision.py.
VISION_ENABLED=false

# AI reports (keep actual credentials in .env only)
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
CVD_REPORT_MODEL=
